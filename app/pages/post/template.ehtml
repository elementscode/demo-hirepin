import "./style.css";
import { ValidationError, redirect } from "@elements/app";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { FieldErrors, ListingFields, blankListingForm } from "#app/shared/templates/listing-fields";
import { ListingForm } from "#app/shared/services/listings";
import { formatCents } from "#app/shared/format";
import { createListing } from "./services";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Checkbox } from "@elements/ui/checkbox";
import { Field, FieldContent, FieldDescription, FieldLabel, FieldTitle } from "@elements/ui/field";

interface PostState {
  form: ListingForm;
  feature: boolean;
  errors: FieldErrors;
  error: string;
  busy: boolean;
}

async function onSubmit(state: PostState) {
  state.busy = true;
  state.error = "";

  try {
    let result = await createListing(state.form, state.feature);
    redirect(result.redirectTo);
  } catch (err: any) {
    state.busy = false;

    if (err instanceof ValidationError) {
      state.errors = err.errors as FieldErrors;
      state.error = "Some fields need a look before you can continue.";
      return;
    }

    state.error = err.message ?? "Something went wrong. Try again.";
  }
}

function total(feature: boolean): number {
  return config.hirepin.publishCents + (feature ? config.hirepin.featureCents : 0);
}

<html lang="en" class="page-post" (
  isAdmin: boolean,
  private state: PostState = { form: blankListingForm(), feature: false, errors: {}, error: "", busy: false },
)>
  <head>
    <title>Post a job · hirepin</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {isAdmin}>
      <div class="page-shell post-page stack is-xl">
        <div class="stack is-sm">
          <p class="eyebrow">For employers</p>
          <h1>Post a remote job</h1>
          <p class="lede">
            {formatCents(config.hirepin.publishCents)} for {config.hirepin.listingDays} days on the board and in the
            weekly email. No account: we email you a private link to edit it.
          </p>
        </div>

        <form class="post-layout" onsubmit={() => onSubmit(state)}>
          <ListingFields form={state.form} errors={state.errors} />

          <Card title="Your order" level={2} class="post-summary">
            <CardContent class="stack is-md">
              <div class="post-line">
                <span>Listing, {config.hirepin.listingDays} days</span>
                <span>{formatCents(config.hirepin.publishCents)}</span>
              </div>

              <FieldLabel>
                <Field orientation="horizontal" reserveError={false}>
                  <Checkbox checked={state.feature} />
                  <FieldContent>
                    <FieldTitle>Feature it for {formatCents(config.hirepin.featureCents)}</FieldTitle>
                    <FieldDescription>Pinned to the top of the board and highlighted for the full {config.hirepin.listingDays} days.</FieldDescription>
                  </FieldContent>
                </Field>
              </FieldLabel>

              <div class="post-line is-total">
                <span>Total</span>
                <span>{formatCents(total(state.feature))}</span>
              </div>

              <Alert e:if={state.error} variant="danger" description={state.error} />

              <Button type="submit" variant="primary" size="lg" block loading={state.busy}>Continue to payment</Button>

              <p class="hint">Secure card payment by Stripe. Your listing goes live the moment payment clears.</p>
            </CardContent>
          </Card>
        </form>
      </div>
    </Layout>
  </body>
</html>
