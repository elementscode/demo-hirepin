import "./style.css";
import { raw } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { CATEGORY_LABELS, JOB_TYPE_LABELS, Listing } from "#app/shared/services/listings";
import { formatDate, formatSalary } from "#app/shared/format";
import { Avatar } from "@elements/ui/avatar";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";

function hostOf(url: string): string {
  return url.replace(/^https?:\/\//, "").replace(/\/.*$/, "");
}

<html lang="en" class="page-job" (listing: Listing, body: string, isAdmin: boolean)>
  <head>
    <title>{listing.title} at {listing.companyName} · hirepin</title>
    <meta name="description" content={`${listing.title} at ${listing.companyName}. ${listing.location}, ${formatSalary(listing.salaryMin, listing.salaryMax)}.`}>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {isAdmin}>
      <div class="page-shell job-page stack is-lg">
        <a class="job-back link-muted" href="/">← All jobs</a>

        <div class="job-layout">
          <article class="stack is-xl">
            <header class="job-head">
              <Avatar class="job-head-logo" shape="square" src={listing.logoUrl ?? ""} alt={listing.logoUrl ? `${listing.companyName} logo` : ""} fallback={listing.companyName.slice(0, 1)} />

              <div class="stack is-xs">
                <h1>{listing.title}</h1>
                <div class="job-head-company">{listing.companyName} · {listing.location}</div>
                <div class="cluster is-xs">
                  <Badge e:if={listing.featured} variant="accent">Featured</Badge>
                  <Badge variant="neutral">{CATEGORY_LABELS[listing.category]}</Badge>
                  <Badge variant="neutral">{JOB_TYPE_LABELS[listing.jobType]}</Badge>
                </div>
              </div>
            </header>

            <div class="prose">{raw(body)}</div>

            <div class="job-apply-foot cluster">
              <Button variant="primary" size="lg" href={listing.applyUrl} attrs={{ target: "_blank", rel: "noopener nofollow" }}>Apply for this job</Button>
              <span class="hint">Opens {listing.companyName}'s application page.</span>
            </div>
          </article>

          <Card class="job-aside">
            <CardContent class="stack is-md">
              <Button variant="primary" block href={listing.applyUrl} attrs={{ target: "_blank", rel: "noopener nofollow" }}>Apply now</Button>

              <dl class="job-facts">
                <dt>Salary</dt>
                <dd>{formatSalary(listing.salaryMin, listing.salaryMax)}</dd>
                <dt>Location</dt>
                <dd>{listing.location}</dd>
                <dt>Type</dt>
                <dd>{JOB_TYPE_LABELS[listing.jobType]}</dd>
                <dt>Posted</dt>
                <dd>{listing.publishedAt ? formatDate(listing.publishedAt) : ""}</dd>
                <dt e:if={listing.companyUrl}>Website</dt>
                <dd e:if={listing.companyUrl}>
                  <a href={listing.companyUrl} target="_blank" rel="noopener nofollow">{hostOf(listing.companyUrl)}</a>
                </dd>
              </dl>

              <Button e:if={isAdmin} variant="ghost" size="sm" block href={`/admin?q=${encodeURIComponent(listing.title)}`}>Review in admin</Button>
            </CardContent>
          </Card>
        </div>
      </div>
    </Layout>
  </body>
</html>
