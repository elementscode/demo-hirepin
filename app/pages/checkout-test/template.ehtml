import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { ListingPurchase, PurchaseLine } from "#app/shared/checkout";
import { formatCents } from "#app/shared/format";
import { payTestListing } from "./services";
import { Alert } from "@elements/ui/alert";
import { Avatar } from "@elements/ui/avatar";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";

interface PayState {
  busy: boolean;
  error: string;
}

function onPay(purchase: ListingPurchase, state: PayState) {
  state.busy = true;
  state.error = "";

  try {
    redirect(payTestListing(purchase.editToken, purchase.feature));
  } catch (err: any) {
    state.busy = false;
    state.error = err.message ?? "Could not record the payment. Try again.";
  }
}

<html lang="en" class="page-checkout-test" (
  purchase: ListingPurchase,
  lines: PurchaseLine[],
  total: number,
  private state: PayState = { busy: false, error: "" },
)>
  <head>
    <title>Checkout · hirepin</title>
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="checkout-shell">
      <div class="checkout-top row">
        <a href="/" class="checkout-brand row">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7z" fill="currentColor"/>
            <circle cx="12" cy="9" r="2.6" fill="var(--bg)"/>
          </svg>
          hirepin
        </a>
        <Badge variant="warning" dot>Test mode</Badge>
      </div>

      <section class="checkout-card card" aria-labelledby="checkout-title">
        <div class="checkout-head">
          <Avatar class="checkout-logo" shape="square" src={purchase.logoUrl ?? ""} fallback={purchase.companyName.slice(0, 1)} />
          <div class="stack is-xs">
            <p class="eyebrow">Pay hirepin</p>
            <h1 id="checkout-title" class="checkout-total">{formatCents(total)}</h1>
          </div>
        </div>

        <ul class="checkout-lines">
          <li e:for={line of lines} class="checkout-line">
            <span class="stack is-xs">
              <strong>{line.name}</strong>
              <span class="hint">{line.detail}</span>
            </span>
            <span class="checkout-amount">{formatCents(line.amount)}</span>
          </li>
          <li class="checkout-line is-total">
            <span>Total due</span>
            <span class="checkout-amount">{formatCents(total)}</span>
          </li>
        </ul>

        <div class="checkout-pay stack is-sm">
          <Alert e:if={state.error} variant="danger" description={state.error} />
          <Button variant="primary" size="lg" block loading={state.busy} onclick={() => onPay(purchase, state)}>Pay {formatCents(total)}</Button>
          <Button variant="ghost" block href={`/manage/${purchase.editToken}`}>Cancel</Button>
        </div>
      </section>

      <p class="checkout-note">
        No card is charged on this page. It stands in for Stripe while the app runs without a key: Pay records
        the payment the same way a real one is recorded. Add <code>STRIPE_SECRET_KEY</code> to
        {" "}<code>config/env/development.env</code> and this button goes to real Stripe Checkout.
      </p>
    </main>
  </body>
</html>
