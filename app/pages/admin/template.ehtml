import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { signout } from "#app/shared/services/auth";
import { CATEGORY_LABELS, ListingStatus } from "#app/shared/services/listings";
import { formatCents, formatDate } from "#app/shared/format";
import { AdminListing, AdminStats, removeListing, restoreListing } from "./services";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { DataTable, DataTableColumn, DataRow, RowAction } from "@elements/ui/data-table";
import { Tabs, TabsList, TabsTrigger } from "@elements/ui/tabs";

type StatusFilter = ListingStatus | "all";

const TABS: { value: StatusFilter; label: string }[] = [
  { value: "all", label: "All" },
  { value: "live", label: "Live" },
  { value: "draft", label: "Drafts" },
  { value: "expired", label: "Expired" },
  { value: "removed", label: "Removed" },
];

interface AdminState {
  listings: AdminListing[];
  query: string;
  status: StatusFilter;
  removing: AdminListing | null;
  confirming: boolean;
}

function shown(state: AdminState): AdminListing[] {
  return state.listings.filter((l) => state.status === "all" || l.status === state.status);
}

function dash(value: unknown): string {
  return value == null ? "–" : "";
}

const COLUMNS: DataTableColumn[] = [
  {
    id: "listing",
    header: "Listing",
    rowHeader: true,
    value: (l) => `${l.title} ${l.companyName} ${l.employerEmail}`,
    cell: (l) => ({
      text: l.title,
      description: `${l.companyName} · ${l.employerEmail}`,
    }),
    sortFn: (a, b) => String(a.original.title).localeCompare(String(b.original.title)),
  },
  {
    id: "status",
    header: "Status",
    type: "tags",
    value: (l) => (l.featured ? [l.status, "featured"] : [l.status]),
    options: [
      { value: "live", tone: "success" },
      { value: "draft", tone: "warning" },
      { value: "expired", tone: "outline" },
      { value: "removed", tone: "danger" },
      { value: "featured", tone: "accent" },
    ],
    searchable: false,
  },
  { id: "category", header: "Category", value: (l) => CATEGORY_LABELS[l.category as keyof typeof CATEGORY_LABELS], searchable: false },
  { key: "publishedAt", header: "Published", type: "date", cell: (l, v) => (v ? formatDate(v as Date) : dash(v)) },
  { key: "expiresAt", header: "Expires", type: "date", cell: (l, v) => (v ? formatDate(v as Date) : dash(v)) },
  { key: "paidCents", header: "Paid", type: "number", cell: (l, v) => ((v as number) > 0 ? formatCents(v as number) : "–") },
];

function actions(state: AdminState): RowAction[] {
  return [
    {
      id: "view",
      label: "View on the board",
      icon: "external-link",
      hidden: (l) => l.status !== "live",
      onSelect: (l) => redirect(`/jobs/${l.id}`),
    },
    {
      id: "edit",
      label: "Edit",
      icon: "pencil",
      hidden: (l) => l.status === "removed",
      onSelect: (l) => redirect(`/manage/${l.editToken}`),
    },
    {
      id: "remove",
      label: "Remove",
      icon: "trash",
      variant: "danger",
      hidden: (l) => l.status === "removed",
      onSelect: (l) => {
        state.removing = l as AdminListing;
        state.confirming = true;
      },
    },
    {
      id: "restore",
      label: "Restore",
      icon: "undo",
      hidden: (l) => l.status !== "removed",
      onSelect: (l) => {
        void onRestore(state, l as AdminListing);
      },
    },
  ];
}

function countOf(state: AdminState, status: StatusFilter): number {
  return status === "all" ? state.listings.length : state.listings.filter((l) => l.status === status).length;
}

function onRemove(state: AdminState) {
  if (state.removing) {
    state.listings = removeListing(state.removing.id);
  }
}

function removeTitle(listing: AdminListing | null): string {
  return listing ? `Remove "${listing.title}" at ${listing.companyName}?` : "";
}

async function onRestore(state: AdminState, listing: AdminListing): Promise<void> {
  state.listings = restoreListing(listing.id);
}

function onSignout() {
  signout();
  redirect("/");
}

<html lang="en" class="page-admin" (
  initial: AdminListing[],
  stats: AdminStats,
  query: string,
  private state: AdminState = { listings: initial, query, status: "all" as StatusFilter, removing: null, confirming: false },
)>
  <head>
    <title>Admin · hirepin</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout isAdmin={true}>
      <div class="page-shell admin-page stack is-xl">
        <div class="admin-head row">
          <div class="stack is-xs">
            <p class="eyebrow">Admin</p>
            <h1>Listings</h1>
          </div>
          <div class="cluster">
            <Button variant="ghost" size="sm" onclick={() => onSignout()}>Sign out</Button>
          </div>
        </div>

        <div class="admin-stats">
          <Card class="admin-stat"><CardContent>
            <span class="admin-stat-value">{stats.live}</span>
            <span class="admin-stat-label">Live listings</span>
          </CardContent></Card>
          <Card class="admin-stat"><CardContent>
            <span class="admin-stat-value">{stats.featured}</span>
            <span class="admin-stat-label">Featured</span>
          </CardContent></Card>
          <Card class="admin-stat"><CardContent>
            <span class="admin-stat-value">{stats.drafts}</span>
            <span class="admin-stat-label">Unpaid drafts</span>
          </CardContent></Card>
          <Card class="admin-stat"><CardContent>
            <span class="admin-stat-value">{formatCents(stats.revenueCents)}</span>
            <span class="admin-stat-label">Revenue</span>
          </CardContent></Card>
          <Card class="admin-stat"><CardContent>
            <span class="admin-stat-value">{stats.subscribers}</span>
            <span class="admin-stat-label">Email subscribers</span>
          </CardContent></Card>
        </div>

        <div class="stack is-md">
          <Tabs value={state.status} class="admin-tabs">
            <TabsList label="Listing status">
              <TabsTrigger e:for={tab of TABS} value={tab.value}>
                {tab.label} <span class="hint">{countOf(state, tab.value)}</span>
              </TabsTrigger>
            </TabsList>
          </Tabs>

          <DataTable data={shown(state)}
                     columns={COLUMNS}
                     label="Listings"
                     search={state.query}
                     searchPlaceholder="Search listings"
                     actions={actions(state)}
                     emptyText="No listings match."
                     pagination={false}
                     filterable={false}
                     exportable={false}
                     groupable={false} />
        </div>

        <AlertDialog open={state.confirming} title={removeTitle(state.removing)} description="It comes off the board right away.">
          <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction variant="danger" onclick={() => onRemove(state)}>Remove</AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialog>
      </div>
    </Layout>
  </body>
</html>
