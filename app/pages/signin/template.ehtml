import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { signin } from "#app/shared/services/auth";
import { Alert, AlertTitle, AlertDescription } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SigninForm) {
  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/admin");
  } catch (err: any) {
    form.error = err.message;
  }
}

function useDemo(form: SigninForm) {
  form.email = "admin@hirepin.dev";
  form.password = "hirepin-admin";
}

<html lang="en" class="page-signin" (
  showDemoLogin: boolean,
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Admin sign in · hirepin</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell is-narrow signin-page stack is-lg">
        <div class="stack is-xs">
          <h1>Admin sign in</h1>
          <p class="hint">Employers don't need an account: use the link in your email.</p>
        </div>

        <Alert e:if={showDemoLogin} variant="accent" role="none" class="signin-demo">
          <AlertTitle>Demo admin login</AlertTitle>
          <AlertDescription>
            <dl>
              <dt>Email</dt>
              <dd><code>admin@hirepin.dev</code></dd>
              <dt>Password</dt>
              <dd><code>hirepin-admin</code></dd>
            </dl>
            <p><Button size="sm" onclick={() => useDemo(form)}>Fill it in</Button></p>
          </AlertDescription>
        </Alert>

        <form class="stack" onsubmit={() => onSubmit(form)}>
          <Alert e:if={form.error} variant="danger" description={form.error} />

          <Field label="Email" reserveError={false}>
            <Input type="email" name="email" value={form.email} required attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: false }} />
          </Field>

          <Field label="Password" reserveError={false}>
            <Input type="password" name="password" value={form.password} required attrs={{ id: "password", autocomplete: "current-password" }} />
          </Field>

          <Button type="submit" variant="primary" block>Sign in</Button>
        </form>
      </div>
    </Layout>
  </body>
</html>
