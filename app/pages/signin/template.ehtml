import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { signin } from "#app/shared/services/auth";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SigninForm) {
  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/admin");
  } catch (err: any) {
    form.error = err.message;
  }
}

function useDemo(form: SigninForm) {
  form.email = "admin@hirepin.dev";
  form.password = "hirepin-admin";
}

<html lang="en" class="page-signin" (
  showDemoLogin: boolean,
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Admin sign in · hirepin</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell is-narrow signin-page stack is-lg">
        <div class="stack is-xs">
          <h1>Admin sign in</h1>
          <p class="hint">Employers don't need an account: use the link in your email.</p>
        </div>

        <div e:if={showDemoLogin} class="callout is-accent signin-demo">
          <div class="callout-title">Demo admin login</div>
          <div class="callout-body">
            <dl>
              <dt>Email</dt>
              <dd><code>admin@hirepin.dev</code></dd>
              <dt>Password</dt>
              <dd><code>hirepin-admin</code></dd>
            </dl>
            <p><button type="button" class="is-sm" onclick={() => useDemo(form)}>Fill it in</button></p>
          </div>
        </div>

        <form class="stack" onsubmit={() => onSubmit(form)}>
          <p e:if={form.error} class="error" role="alert">{form.error}</p>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value={form.email} autocomplete="email" autocapitalize="none" spellcheck={false} required>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" value={form.password} autocomplete="current-password" required>
          </div>

          <button type="submit" class="is-primary is-block">Sign in</button>
        </form>
      </div>
    </Layout>
  </body>
</html>
