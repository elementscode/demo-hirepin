import "./style.css";
import { raw } from "@elements/app";
import {
  CATEGORIES,
  CATEGORY_LABELS,
  JOB_TYPES,
  JOB_TYPE_LABELS,
  ListingForm,
} from "#app/shared/services/listings";
import { renderMarkdown } from "#app/shared/markdown";
import { Avatar } from "@elements/ui/avatar";
import { Field, FieldLabel } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { InputGroup, InputGroupAddon, InputGroupText } from "@elements/ui/input-group";
import { NativeSelect } from "@elements/ui/native-select";
import { NumberInput } from "@elements/ui/number-input";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@elements/ui/tabs";
import { Textarea } from "@elements/ui/textarea";

export type FieldErrors = Record<string, string[] | undefined>;

export const DESCRIPTION_TEMPLATE = `## About the company

A few sentences on what you make and who uses it.

## The role

What this person will own in their first six months.

## What we're looking for

- Experience you need
- Experience that's a bonus

## Compensation and benefits

- Salary range, equity, and the benefits that matter
`;

export function blankListingForm(): ListingForm {
  return {
    companyName: "",
    companyUrl: "",
    title: "",
    category: "engineering",
    jobType: "full-time",
    location: "Remote, worldwide",
    salaryMin: 0,
    salaryMax: 0,
    description: DESCRIPTION_TEMPLATE,
    applyUrl: "",
    employerEmail: "",
    logo: [],
  };
}

function first(messages: string[] | undefined): string {
  return messages?.[0] ?? "";
}

/**
 * The listing's fields, shared by the post page and the employer's manage
 * page. The caller owns the <form> and the submit.
 */
<ListingFields (
  form: ListingForm,
  errors: FieldErrors,
  logoUrl: string | null = null,
  showEmail: boolean = true,
  private tab: { mode: string } = { mode: "write" },
)>
  <div class="listing-fields stack is-lg">
    <section class="stack is-md">
      <h2 class="eyebrow">Company</h2>

      <Field label="Company name" error={first(errors.companyName)}>
        <Input value={form.companyName} required attrs={{ id: "companyName", autocomplete: "organization" }} />
      </Field>

      <Field error={first(errors.companyUrl)}>
        <FieldLabel>Company website <span class="hint">optional</span></FieldLabel>
        <Input type="url" value={form.companyUrl} placeholder="https://" attrs={{ id: "companyUrl" }} />
      </Field>

      <Field error={first(errors.logo)}>
        <FieldLabel>Logo <span class="hint">optional, square works best</span></FieldLabel>
        <div class="logo-row">
          <Avatar class="logo-preview" shape="square" src={logoUrl ?? ""} alt={logoUrl ? "Current logo" : ""} fallback=" " />
          <Input type="file" files={form.logo} attrs={{ id: "logo", accept: "image/png,image/jpeg,image/gif,image/webp" }} />
        </div>
      </Field>
    </section>

    <section class="stack is-md">
      <h2 class="eyebrow">The job</h2>

      <Field label="Job title" error={first(errors.title)}>
        <Input value={form.title} placeholder="Senior Frontend Engineer" required attrs={{ id: "title" }} />
      </Field>

      <div class="field-pair">
        <Field label="Category">
          <NativeSelect value={form.category} block attrs={{ id: "category" }}>
            <option e:for={cat of CATEGORIES} value={cat}>{CATEGORY_LABELS[cat]}</option>
          </NativeSelect>
        </Field>

        <Field label="Job type">
          <NativeSelect value={form.jobType} block attrs={{ id: "jobType" }}>
            <option e:for={type of JOB_TYPES} value={type}>{JOB_TYPE_LABELS[type]}</option>
          </NativeSelect>
        </Field>
      </div>

      <Field label="Where can they work from?" error={first(errors.location)}>
        <Input value={form.location} placeholder="Remote, US time zones" required attrs={{ id: "location" }} />
      </Field>

      <Field label="Salary range, USD per year" error={first(errors.salaryMin)} description="In thousands: 120 to 150 shows as $120k – $150k.">
        <div class="salary-row">
          <InputGroup>
            <NumberInput value={form.salaryMin} min={1} smallStep={1} buttons="none" invalid={!!errors.salaryMin} attrs={{ id: "salaryMin", "aria-label": "Minimum salary in thousands" }} />
            <InputGroupAddon><InputGroupText>$</InputGroupText></InputGroupAddon>
            <InputGroupAddon align="inline-end"><InputGroupText>k</InputGroupText></InputGroupAddon>
          </InputGroup>
          <span class="hint">to</span>
          <InputGroup>
            <NumberInput value={form.salaryMax} min={1} smallStep={1} buttons="none" invalid={!!errors.salaryMin} attrs={{ "aria-label": "Maximum salary in thousands" }} />
            <InputGroupAddon><InputGroupText>$</InputGroupText></InputGroupAddon>
            <InputGroupAddon align="inline-end"><InputGroupText>k</InputGroupText></InputGroupAddon>
          </InputGroup>
        </div>
      </Field>

      <Field label="Description" error={first(errors.description)} description="Markdown: ## headings, **bold**, - lists and [links](https://…).">
        <Tabs value={tab.mode} variant="segmented" class="description-tabs">
          <TabsList label="Description">
            <TabsTrigger value="write">Write</TabsTrigger>
            <TabsTrigger value="preview">Preview</TabsTrigger>
          </TabsList>
          <TabsContent value="write">
            <Textarea value={form.description} invalid={!!errors.description} rows={16} attrs={{ id: "description" }} />
          </TabsContent>
          <TabsContent value="preview">
            <div class="description-preview prose">{raw(renderMarkdown(form.description))}</div>
          </TabsContent>
        </Tabs>
      </Field>

      <Field label="Apply url" error={first(errors.applyUrl)} description="Where the Apply button goes: your careers page, an ATS link, or mailto:jobs@….">
        <Input value={form.applyUrl} placeholder="https://yourcompany.com/careers/role" required attrs={{ id: "applyUrl" }} />
      </Field>
    </section>

    <section e:if={showEmail} class="stack is-md">
      <h2 class="eyebrow">You</h2>

      <Field label="Your email" error={first(errors.employerEmail)} description="No account needed. We email you a private link to edit the listing, and your receipt.">
        <Input type="email" value={form.employerEmail} placeholder="you@company.com" required attrs={{ id: "employerEmail", autocomplete: "email", autocapitalize: "none", spellcheck: false }} />
      </Field>
    </section>
  </div>
</ListingFields>
