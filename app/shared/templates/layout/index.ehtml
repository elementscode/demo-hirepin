import "./style.css";
import { formatCents } from "#app/shared/format";
import config from "#config";
import { Button } from "@elements/ui/button";

<Layout (isAdmin: boolean = false)>
  <div class="app">
    <header class="site-header">
      <div class="page-shell site-header-inner row">
        <a href="/" class="site-brand row">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7z" fill="currentColor"/>
            <circle cx="12" cy="9" r="2.6" fill="var(--bg)"/>
          </svg>
          hirepin
          <span class="site-brand-tag">remote software jobs</span>
        </a>

        <nav class="site-nav row">
          <Button e:if={isAdmin} href="/admin" variant="ghost" size="sm">Admin</Button>
          <Button href="/" variant="ghost" size="sm" class="is-optional">Browse jobs</Button>
          <Button href="/post" variant="primary" size="sm">Post a job · {formatCents(config.hirepin.publishCents)}</Button>
        </nav>
      </div>
    </header>

    <main class="app-main">
      <slot/>
    </main>

    <footer class="site-footer">
      <div class="page-shell site-footer-inner cluster">
        <span>hirepin · remote jobs in engineering, design, product and marketing</span>
        <nav class="cluster">
          <a class="link-muted" href="/post">Post a job</a>
          <a class="link-muted" href="/signin">Admin sign in</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>
